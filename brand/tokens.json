{
  "$comment": "Copied by hand from BRAND.md, which is itself copied by hand from langx/apps/mobile/src/lib/theme/tokens.ts. That file decides; this one is a convenience for tools that would rather read JSON than a markdown table. If the two disagree, the app is right and both copies here are stale.",
  "version": "v3",
  "appVersions": "2.x",
  "color": {
    "light": {
      "bg": "#ffffff",
      "feedBg": "#ffffff",
      "surface": "#ffffff",
      "fill": "#f4f5f7",
      "border": "#e8eaec",
      "text": "#17191c",
      "textMuted": "#62676d",
      "textFaint": "#9aa1a7",
      "textInverse": "#fefefe",
      "ink": "#17191c",
      "onInkMuted": "rgba(128, 128, 128, 0.45)",
      "primary": "#ffc409",
      "primaryShade": "#e0ac08",
      "primaryText": "#201900",
      "primaryTextMuted": "rgba(32, 25, 0, 0.55)",
      "secondary": "#3b6cf6",
      "accent": "#3b6cf6",
      "accentBg": "#e9f0fe",
      "streak": "#f79009",
      "pro": "#7a5af8",
      "proPlus": "#5b21b6",
      "success": "#009f70",
      "successBg": "#e2f6ee",
      "info": "#3b6cf6",
      "infoBg": "#e9f0fe",
      "warning": "#c87820",
      "warningBg": "#fff6b6",
      "danger": "#e5484d",
      "dangerBg": "#fdecec",
      "dangerShade": "#b83236",
      "knob": "#ffffff",
      "scrim": "rgba(0, 0, 0, 0.45)",
      "scrimStrong": "rgba(0, 0, 0, 0.94)",
      "onScrim": "#ffffff"
    },
    "dark": {
      "$comment": "Only the tokens that move. Everything else is the light value, deliberately: primary and its three companions, knob, onInkMuted, the scrims, textInverse and dangerShade.",
      "bg": "#1c1f24",
      "feedBg": "#1c1f24",
      "surface": "#1c1f24",
      "fill": "#23272d",
      "border": "#2c3036",
      "text": "#f2f3f5",
      "textMuted": "#9aa1a9",
      "textFaint": "#70767e",
      "ink": "#f2f3f5",
      "secondary": "#7c9cf9",
      "accent": "#7c9cf9",
      "accentBg": "#202b45",
      "streak": "#ffa93d",
      "pro": "#9b83ff",
      "proPlus": "#c9b8ff",
      "success": "#34c796",
      "successBg": "#16332a",
      "info": "#7c9cf9",
      "infoBg": "#202b45",
      "warning": "#ffca39",
      "warningBg": "#724413",
      "danger": "#ef6b6f",
      "dangerBg": "#3a2023"
    }
  },
  "rules": [
    "One blue for everything interactive.",
    "Yellow exactly once per screen — the committing action.",
    "No card layer: the ground is the surface, and structure comes from dividers and whitespace.",
    "The yellow does not change between light and dark.",
    "Green is a correction and blue is Copilot. Never swap them.",
    "ink inverts with the ground: it is text used as a fill."
  ],
  "type": {
    "display": {
      "family": "Nunito",
      "weights": [700, 800],
      "licence": "SIL Open Font License 1.1",
      "source": "https://fonts.google.com/specimen/Nunito"
    },
    "body": {
      "family": "platform",
      "$comment": "The platform UI stack. Body text here is often someone's second language and a display face at 13px is a legibility tax."
    },
    "roles": {
      "title": { "size": 30, "weight": 800, "face": "Nunito ExtraBold" },
      "tabRootTitle": { "size": 34, "weight": 800, "face": "Nunito ExtraBold" },
      "heading": { "size": 20, "weight": 800, "face": "Nunito ExtraBold" },
      "body": { "size": 15, "weight": 400, "face": "platform" },
      "label": { "size": 13, "weight": 600, "face": "platform" },
      "caption": { "size": 12, "weight": 400, "face": "platform" }
    }
  },
  "spacing": [4, 8, 12, 16, 24, 32, 48],
  "radius": { "scale": [8, 12, 16, 24, 28], "pill": 999, "$comment": "28 is the sheet's top corners; nothing smaller than a sheet is that round." },
  "shadow": {
    "light": "0 4px 10px rgba(0, 0, 0, 0.06)",
    "dark": "0 4px 10px rgba(0, 0, 0, 0.40)",
    "$comment": "Almost nothing floats in v3 — only sheets, the segmented thumb and the committing button."
  },
  "layout": { "contentMaxWidth": 720 },
  "mark": {
    "$comment": "Geometry on a 1024 canvas, SVG axes with y pointing down. Measured back off brand/icon/default.png; see brand/logo/build.py.",
    "canvas": 1024,
    "outerRadius": 235.3,
    "innerRadius": 151.5,
    "strokeWidth": 83.8,
    "blackArc": { "centre": [591.0, 463.5], "from": 147, "to": 327 },
    "whiteArc": { "centre": [433.0, 560.5], "from": 327, "to": 147, "$comment": "the black arc turned 180 degrees about the canvas centre" },
    "shadow": { "distance": 20, "angle": 57 },
    "minGapBetweenArcs": 102.6,
    "grounds": {
      "yellow": { "fill": "#ffc409", "shadow": "#e0ac08" },
      "ink": { "fill": "#121318", "shadow": "#deab06" },
      "pro": { "fill": "#7a5af8", "shadow": "#6b4fda" }
    },
    "arcs": { "black": "#000000", "white": "#ffffff" }
  },
  "lockup": {
    "$comment": "Horizontal lockup, built from the mark height H.",
    "gap": 0.24,
    "wordmarkSize": 0.64,
    "wordmarkTracking": "-0.02em",
    "wordmarkFace": "Nunito ExtraBold",
    "wordmarkColour": { "light": "#17191c", "dark": "#f2f3f5" },
    "baseline": 0.6806,
    "aspect": 3.115
  },
  "clearSpace": {
    "$comment": "Keep 0.24 of the mark's height clear on every side — the same measure as the lockup's own gap.",
    "factor": 0.24
  },
  "minimumSize": {
    "markScreenPx": 16,
    "markPrintMm": 8,
    "markOneColourPrintMm": 10,
    "lockupScreenPx": 24,
    "lockupPrintMm": 12
  }
}
